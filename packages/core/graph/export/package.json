{
  "name": "@exadev/process-graph-export",
  "version": "1.0.2",
  "description": "Text exports of a projected view: Mermaid and Graphviz DOT for every notation, and the projection as JSON, with every label from a source made safe to show.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/process-graph.git",
    "directory": "packages/core/graph/export"
  },
  "homepage": "https://github.com/ExaDev/process-graph/tree/main/packages/core/graph/export#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/process-graph/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "turbo run _build",
    "_build": "tsc -b tsconfig.build.json",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "_lint:fix": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck _typecheck:attw",
    "_typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "_typecheck:attw": "attw --pack --profile esm-only",
    "test": "turbo run _test",
    "_test": "vitest run --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "vitest run --project unit --coverage",
    "test:smoke": "turbo run _test:smoke",
    "_test:smoke": "vitest run --project smoke",
    "test:mutation": "turbo run _test:mutation",
    "_test:mutation": "stryker run stryker.config.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint && attw --pack --profile esm-only"
  },
  "keywords": [
    "process-model",
    "mermaid",
    "graphviz",
    "dot",
    "export"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@exadev/process-graph-projection": "workspace:*",
    "@exadev/process-graph-schema": "workspace:*"
  }
}
