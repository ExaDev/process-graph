{
  "name": "@exadev/process-graph-ui",
  "version": "1.0.1",
  "private": true,
  "description": "Styled React components for the process model over the headless graph-react package, styled with Vanilla Extract: a typed theme contract with light and dark themes, recipes for variants, and an SVG sequence diagram. Ships compiled CSS, so a consumer needs no build plugin.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/process-graph.git",
    "directory": "packages/ui/graph/ui"
  },
  "homepage": "https://github.com/ExaDev/process-graph/tree/main/packages/ui/graph/ui#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/process-graph/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "scripts": {
    "build": "turbo run _build",
    "_build": "vite build && tsc -b tsconfig.build.json",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "_lint:fix": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck _typecheck:attw",
    "_typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "_typecheck:attw": "attw --pack --profile esm-only --exclude-entrypoints ./style.css",
    "test": "turbo run _test",
    "_test": "vitest run --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "vitest run --project unit --coverage",
    "test:smoke": "turbo run _test:smoke",
    "_test:smoke": "vitest run --project smoke",
    "test:mutation": "turbo run _test:mutation",
    "_test:mutation": "stryker run stryker.config.ts"
  },
  "keywords": [
    "process-model",
    "react",
    "vanilla-extract",
    "theme",
    "sequence-diagram"
  ],
  "dependencies": {
    "@exadev/process-graph-domain": "1.1.1",
    "@exadev/process-graph-projection": "1.1.0",
    "@exadev/process-graph-react": "1.0.1",
    "@exadev/process-graph-schema": "1.1.0",
    "@vanilla-extract/recipes": "0.5.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "19.3.0"
  }
}
