{
  "name": "@exadev/process-graph-store-sqlite",
  "version": "1.0.1",
  "description": "The GraphStore port on SQLite through Drizzle: one schema, committed drizzle-kit migrations applied the same way in every runtime, recursive SQL for the structural queries, written against Drizzle's async SQLite database so any driver plugs in.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/process-graph.git",
    "directory": "packages/adapters/graph/store-sqlite"
  },
  "homepage": "https://github.com/ExaDev/process-graph/tree/main/packages/adapters/graph/store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/process-graph/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "turbo run _build",
    "_build": "node scripts/embed-migrations.ts && tsc -b tsconfig.build.json",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "_lint:fix": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck _typecheck:attw",
    "_typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "_typecheck:attw": "attw --pack --profile esm-only",
    "test": "turbo run _test",
    "_test": "node scripts/embed-migrations.ts && vitest run --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "node scripts/embed-migrations.ts && vitest run --project unit --coverage",
    "test:smoke": "turbo run _test:smoke",
    "_test:smoke": "vitest run --project smoke",
    "test:mutation": "turbo run _test:mutation",
    "_test:mutation": "node scripts/embed-migrations.ts && stryker run stryker.config.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint && attw --pack --profile esm-only",
    "migrations:generate": "drizzle-kit generate"
  },
  "keywords": [
    "process-model",
    "store",
    "sqlite",
    "drizzle",
    "orpc"
  ],
  "dependencies": {
    "@exadev/process-graph-domain": "1.0.3",
    "@exadev/process-graph-schema": "1.1.0",
    "@exadev/process-graph-store-contract": "1.0.1",
    "@orpc/server": "2.0.0-beta.41",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "10.12.0",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
