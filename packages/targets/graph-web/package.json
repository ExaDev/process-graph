{
  "name": "@exadev/process-graph-web",
  "version": "1.1.1",
  "private": true,
  "description": "The process-graph web app: an installable, offline-first PWA that syncs GitHub issues into a SQLite store on the origin private file system and shows the work as a flowchart, swimlane, state machine or sequence diagram, with what is ready, what is blocked and why.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/process-graph.git",
    "directory": "packages/targets/graph-web"
  },
  "homepage": "https://github.com/ExaDev/process-graph/tree/main/packages/targets/graph-web#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/process-graph/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run _build",
    "_build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "_lint:fix": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck",
    "_typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "turbo run _test",
    "_test": "vitest run --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "vitest run --project unit --coverage",
    "test:smoke": "turbo run _test:smoke",
    "_test:smoke": "vitest run --project smoke",
    "test:e2e": "turbo run _test:e2e",
    "_test:e2e": "playwright test"
  },
  "keywords": [
    "process-model",
    "pwa",
    "offline",
    "github-issues",
    "react"
  ],
  "dependencies": {
    "@exadev/process-graph-domain": "workspace:*",
    "@exadev/process-graph-projection": "workspace:*",
    "@exadev/process-graph-react": "workspace:*",
    "@exadev/process-graph-react-flow": "workspace:*",
    "@exadev/process-graph-schema": "workspace:*",
    "@exadev/process-graph-source-contract": "workspace:*",
    "@exadev/process-graph-source-github-issues": "workspace:*",
    "@exadev/process-graph-sqlite-wasm": "workspace:*",
    "@exadev/process-graph-store-contract": "workspace:*",
    "@exadev/process-graph-ui": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:",
    "workbox-window": "catalog:"
  }
}
