{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "_build": {
      "env": ["GRAPH_WEB_BASE"],
      "inputs": ["$TURBO_EXTENDS$", "index.html", "build/**", "vite.config.ts"]
    },
    "_test:e2e": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!test-results/**",
        "!playwright-report/**"
      ]
    }
  }
}
