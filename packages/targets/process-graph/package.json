{
  "name": "process-graph",
  "version": "1.2.0",
  "description": "A process and dependency graph model with projections into flowcharts, swimlanes, state machines and sequence diagrams, reasoning over a run, layout, the GitHub issues source, the SQLite store for Node and the browser, and the process-graph command line, each behind its own subpath.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/process-graph.git",
    "directory": "packages/targets/process-graph"
  },
  "homepage": "https://github.com/ExaDev/process-graph/tree/main/packages/targets/process-graph#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/process-graph/issues"
  },
  "bin": {
    "process-graph": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./source/github": {
      "types": "./dist/source/github.d.ts",
      "import": "./dist/source/github.js"
    },
    "./source/github/node": {
      "types": "./dist/source/github/node.d.ts",
      "import": "./dist/source/github/node.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./store/node": {
      "types": "./dist/store/node.d.ts",
      "import": "./dist/store/node.js"
    },
    "./store/wasm": {
      "types": "./dist/store/wasm.d.ts",
      "import": "./dist/store/wasm.js"
    },
    "./store/wasm/worker": {
      "types": "./dist/store/wasm/worker.d.ts",
      "import": "./dist/store/wasm/worker.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./react-flow": {
      "types": "./dist/react-flow.d.ts",
      "import": "./dist/react-flow.js"
    },
    "./ui/style.css": "./dist/ui/style.css",
    "./react-flow/style.css": "./dist/react-flow/style.css",
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "./dist/bin.js",
    "*.css"
  ],
  "license": "MIT",
  "scripts": {
    "build": "turbo run _build",
    "_build": "tsdown",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "_lint:fix": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "turbo run _typecheck _typecheck:attw",
    "_typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "_typecheck:attw": "attw --pack --profile esm-only --exclude-entrypoints ./ui/style.css ./react-flow/style.css",
    "test": "turbo run _test",
    "_test": "vitest run --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "vitest run --project unit --coverage",
    "test:integration": "turbo run _test:integration",
    "_test:integration": "vitest run --project browser",
    "test:smoke": "turbo run _test:smoke",
    "_test:smoke": "vitest run --project smoke",
    "test:mutation": "turbo run _test:mutation",
    "_test:mutation": "stryker run stryker.config.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint && attw --pack --profile esm-only --exclude-entrypoints ./ui/style.css ./react-flow/style.css"
  },
  "keywords": [
    "process-model",
    "dependency-graph",
    "flowchart",
    "swimlane",
    "state-machine",
    "sequence-diagram"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@exadev/process-graph-cli": "1.1.0",
    "@exadev/process-graph-dag": "1.1.1",
    "@exadev/process-graph-domain": "1.2.0",
    "@exadev/process-graph-layout": "1.0.4",
    "@exadev/process-graph-projection": "1.1.1",
    "@exadev/process-graph-react": "1.1.1",
    "@exadev/process-graph-react-flow": "1.1.1",
    "@exadev/process-graph-schema": "1.1.1",
    "@exadev/process-graph-source-contract": "1.1.1",
    "@exadev/process-graph-source-github-issues": "1.1.1",
    "@exadev/process-graph-sqlite-node": "1.0.6",
    "@exadev/process-graph-sqlite-wasm": "1.0.5",
    "@exadev/process-graph-store-contract": "1.2.0",
    "@exadev/process-graph-store-sqlite": "1.2.0",
    "@exadev/process-graph-ui": "1.0.3",
    "@orpc/client": "2.0.0-beta.41",
    "@orpc/contract": "2.0.0-beta.41",
    "@orpc/server": "2.0.0-beta.41",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/recipes": "0.5.7",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@xyflow/react": "12.12.0",
    "commander": "15.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "elkjs": "0.12.0",
    "eslint": "10.12.0",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "trilean": "1.7.2",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@orpc/client": "2.0.0-beta.41",
    "@orpc/contract": "2.0.0-beta.41",
    "@orpc/server": "2.0.0-beta.41",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/recipes": "0.5.7",
    "@xyflow/react": "12.12.0",
    "commander": "15.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependenciesMeta": {
