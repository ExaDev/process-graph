      "optional": true
    },
    "@orpc/contract": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "@vanilla-extract/css": {
      "optional": true
    },
    "@vanilla-extract/recipes": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
