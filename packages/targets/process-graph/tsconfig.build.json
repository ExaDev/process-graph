{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test-support/**"],
  "references": [
    {
      "path": "../../core/graph/dag/tsconfig.build.json"
    },
    {
      "path": "../../core/graph/schema/tsconfig.build.json"
    },
    {
      "path": "../../core/graph/projection/tsconfig.build.json"
    },
    {
      "path": "../../core/graph/domain/tsconfig.build.json"
    },
    {
      "path": "../graph-cli/tsconfig.build.json"
    }
  ]
}
