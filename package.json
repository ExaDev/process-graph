{
  "name": "process-graph",
  "private": true,
  "description": "Workspace root for process-graph: a process and dependency graph model, reasoning, CLI and React UI over multiple task sources. Never published; the unscoped process-graph package is a separate workspace package.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/process-graph.git"
  },
  "homepage": "https://github.com/ExaDev/process-graph#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/process-graph/issues"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run _build",
    "build:tsc": "tsc -b tsconfig.build.json",
    "dev": "turbo run _dev",
    "lint": "turbo run _lint _lint-all",
    "lint:fix": "turbo run _lint:fix _lint:fix-all",
    "typecheck": "turbo run _typecheck _typecheck:attw _typecheck-all",
    "test": "turbo run _test _test-all",
    "test:coverage": "turbo run _test:coverage",
    "test:integration": "turbo run _test:integration",
    "test:smoke": "turbo run _test:smoke",
    "test:e2e": "turbo run _test:e2e",
    "test:mutation": "turbo run _test:mutation",
    "deps:lint": "syncpack lint && node scripts/check-published-manifests.ts",
    "deps:fix": "syncpack fix",
    "release": "semantic-release-workspace release --config release-workspace.config.ts",
    "prepare": "husky",
    "_lint": "eslint . --cache --max-warnings 0",
    "_lint:fix": "eslint . --fix --cache --max-warnings 0",
    "_typecheck": "tsc -p tsconfig.json --noEmit",
    "_test": "vitest run --project unit",
    "_prepush": "turbo run _lint _lint-all _typecheck _typecheck-all _test _test-all _test:integration _test:smoke"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@eslint/js": "catalog:",
    "@eslint/json": "catalog:",
    "@eslint/markdown": "catalog:",
    "@exadev/eslint-config": "catalog:",
    "@exadev/semantic-release-workspace": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/commit-analyzer": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@semantic-release/npm": "catalog:",
    "@semantic-release/release-notes-generator": "catalog:",
    "@stryker-mutator/api": "catalog:",
    "@types/node": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-depend": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-yml": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
